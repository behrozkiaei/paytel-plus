// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}
model User{
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  mobile String @unique
  name  String?
  address String?
  username String?
  description String?
  email String? 
  lat String?
  lan String?
  status String?
  avatar String?
  role Role? @default(LEVEL1)
  website String?
  contantPersonName String?
  contactPersonPhone String?
  icon String?
  active Boolean? @default(true)
  verified Boolean? @default(false)
  phone String?
  Wallet Wallet?
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
  sheba  String?
  card String?
  verified_bank Boolean? @default(false)
  dateVerified String? 
  date String? 
  password String?
  password2 String?
  loginTime String?
  otpType OtpType?  @default(Login)
  otpDate String?
  nationalCode String?
  cartMelli String?
  shenasname String?
  fcmToken String?
  paymentRequest UserPaymentRequest[]
  fromUsers LastPaidFriends[]  @relation("fromUserId")
  destUsers LastPaidFriends[]  @relation("destUserId")
  order Order[]
  @@map("user")
}


model Wallet {
    id     String @id @default(auto()) @map("_id") @db.ObjectId
    User    User  @relation(fields: [userId], references: [id])
    userId  String @unique @db.ObjectId
    transactions Transaction[]
    name String?
    amount Float @default(0)
    walletCode String @unique 
    walletType String? @default("USER")
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    date String 
    sourceWallet WalletTransfer[]  @relation("sourceWallet")
    destWallet WalletTransfer[]  @relation("destWallet")
    @@map("wallet")
}

//bank tranaction 
model Transaction {
    id     String @id @default(auto()) @map("_id") @db.ObjectId
    //for increase wallet
    wallet    Wallet?  @relation(fields: [destWalletId], references: [id])
    destWalletId String?  @db.ObjectId
    amount Float
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    date String  
    resnum String?
    rrn String?
    traceNum String?
    isPaid Boolean @default(false)
    securePan String @unique 
    datePaid String?
    card_pan String?
    ref_id Float?
    fee_type String?
    fee Int?
    //for order pruduct
    order    Order?  @relation(fields: [orderId], references: [id])
    orderId  String? @unique @db.ObjectId
    @@map("transaction")
}
model Order {
    id     String @id @default(auto()) @map("_id") @db.ObjectId
    transaction Transaction?
    type OrderType
    amount Float
    user    User  @relation(fields: [userId], references: [id])
    userId  String  @db.ObjectId
    desc keyValue[]
    date String  
    title String?
    subTitle String?
    avatar String?
    isPaid Boolean @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    datePaid String?  
    data1 String?
    data2 String?
    data3 String?
    data4 String?
    payload String?  /// should be fource to insert !!!!!!!!!!!!!!!!!!!

    @@map("order")
}
model keyValue {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  key     String
  value   String
  order  Order @relation(fields: [orderId], references: [id])
  orderId String  @db.ObjectId
}
//wallet to wallet transfer
model WalletTransfer {
    id     String @id @default(auto()) @map("_id") @db.ObjectId
    walletSource    Wallet  @relation("sourceWallet",fields: [sourceWalletId], references: [id])
    sourceWalletId String  @db.ObjectId
    walletDest    Wallet  @relation("destWallet",fields: [destWalletId], references: [id])
    destWalletId String  @db.ObjectId
    amount Float
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    description String?
    date String  
    @@map("walletTransfer")
}

//requesting to cash back
model UserPaymentRequest{
    id     String @id @default(auto()) @map("_id") @db.ObjectId
    user    User  @relation(fields: [userId], references: [id])
    userId  String  @db.ObjectId
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    description String?
    amount Float
    state CashbackState @default(PENDING)
    desc1  String?
    desc2 String?
    desc3 String?
    bankResponse  String?
    date String  
    dateResponse String?  
    @@map("userPaymentRequest")
}

model Config{
    id     String @id @default(auto()) @map("_id") @db.ObjectId
    paymentService String?
    MID String?
    paymentCallback String?
    paymentLink String?
    fcm_apiKey String?
    payment_apiKey String?
    mapServiceName  String?
    map_apiKey String?
    kavenegar_token String?
    @@map("config")
  }

 model InternetProduct{
     id     String @id @default(auto()) @map("_id") @db.ObjectId
     product_id String?
     name String
     amount String 
     amount_rial String
     sim_type String
     internet_type String
     operator String
     days String
     volume String 
     unit String
     course String
     course_range String
     date String
     createdAt DateTime @default(now())
     updatedAt DateTime @updatedAt
     @@map("internetProduct")
  }

model LastPaidFriends{
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  fromUser    User  @relation("fromUserId",fields: [fromUserId], references: [id])
  fromUserId String  @db.ObjectId
  destUser    User  @relation("destUserId",fields: [destUserId], references: [id])
  destUserId String  @db.ObjectId
}
enum CashbackState {
  PENDING // is pernding to cash back
  DONE   // cash back is done
  REJECTED // cash back is not done
}

enum Role {
  ADMIN
  MASTER
  user 
  LEVEL1 // a usual user who registered in app
  LEVEL2 // a user who filled name
  LEVEL3 // a user who confirm his docs
  LEVEL4 // a user who is veridied as merchant 
}

enum OtpType {
  Login
  RessetPass
}
enum OrderType {
  billByCredit
  billByWallet
  internetByWallet
  internetByCredit
  chargeByWallet
  chargeByCredit
  walletToWallet
  increaseWallet
  creditToOtherWallet
}
